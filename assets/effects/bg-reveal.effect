// 「完成背景」从拼图区中心以圆形羽化向外扩散、盖住原来的底图。
//
// 挂在 Scene_BG 下一个同尺寸的子节点上（贴图就是完成背景那张），只输出圆内的像素：
// 圈外 alpha = 0，露出下面的底图；圆的边缘走 smoothstep，不是硬边。
//
// 半径算在世界坐标里，和 RepairSweep 同一套路数：Sprite 的 a_position 进顶点着色器时
// 已经乘过 node.worldMatrix（引擎在 simple.updateWorldVerts 里预先乘好，
// 2d/assembler/sprite/simple.ts:68），所以片元里直接拿它算距离 —— 节点不是正方形
// （580×748.6），在 uv 里算半径会变成椭圆。顺便绕开动态图集那条坑。
//
// revealParams / revealEdge 由 CPU 按本次尺寸算好塞进来。

CCEffect %{
  techniques:
  - passes:
    - vert: bg-reveal-vs:vert
      frag: bg-reveal-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        revealParams: { value: [0.0, 0.0, 0.0, 1.0] }
        revealEdge: { value: [0.35, 0.0, 0.0, 0.0] }
        revealLook: { value: [0.0, 0.0, 0.0, 0.0] }
}%

CCProgram bg-reveal-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;
  out vec2 world;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;
    world = a_position.xy;

    return pos;
  }
}%

CCProgram bg-reveal-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>

  in vec4 color;
  in vec2 world;

  #if USE_TEXTURE
    in vec2 uv0;
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif

  uniform BgReveal {
    vec4 revealParams;  // xy 圆心（世界坐标）/ z 进度半径（0 = 圆心，1 = 够到四角）/ w 1÷跨度
    vec4 revealEdge;    // x 羽化半宽（相对跨度）
    vec4 revealLook;    // x 边缘提亮 / y 水平波纹开关 / zw 备用
  };

  vec4 frag () {
    #if USE_TEXTURE
      vec4 o = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
      float d = length(world - revealParams.xy) * revealParams.w;

      // 水平波纹：cos²(0.5 - uv0.x) 给每一列一个不同的扩散半径（中缝 1、最左/最右 0）。
      // 从 CopyPuzzle 的 Fader.effect 搬来：那里 same 项乘在「内半径」上，效果是圆的边缘
      // 不再等速前进 —— 左右两侧先到、中缝后到，看着像一道斜光扫过而不是标准同心圆。
      // revealLook.y = 0 时 mix 返回 1，整段退化成正圆（旧行为，结束背景那套没勾过）。
      float w = (0.5 - uv0.x) * 1.5707963;
      float c = cos(w);
      float wave = mix(1.0, 2.0 * c * c, revealLook.y);
      float z = revealParams.z * wave;

      float m = 1.0 - smoothstep(z - revealEdge.x, z + revealEdge.x, d);
      // 边缘提亮：CopyPuzzle Fader 的 brightness=5，按 (1 - a)² 叠在「刚扫到还没盖满」的那一圈上。
      // 圈外 alpha 本来就是 0，这里加的 rgb 出不来，所以只有软边那一条会亮。
      vec3 rgb = o.rgb + o.rgb * revealLook.x * (1.0 - m) * (1.0 - m);
      return vec4(rgb, o.a * m * color.a);
    #else
      return vec4(0.0);
    #endif
  }
}%
