CCEffect %{
  techniques:
  - passes:
    - vert: soft-dot-vs:vert
      frag: soft-dot-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: one
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        dotTint: { value: [1, 1, 1, 1] }
}%

CCProgram soft-dot-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert () {
    vec4 position = vec4(a_position, 1.0);
    #if USE_LOCAL
      position = cc_matWorld * position;
    #endif
    uv0 = a_texCoord;
    color = a_color;
    return cc_matViewProj * position;
  }
}%

CCProgram soft-dot-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  in vec2 uv0;
  in vec4 color;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  uniform SoftDot { vec4 dotTint; };
  vec4 frag () {
    vec4 sampleColor = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
    return vec4(sampleColor.rgb * color.rgb * dotTint.rgb,
      sampleColor.a * color.a * dotTint.a);
  }
}%
